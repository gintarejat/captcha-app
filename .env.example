# Copy to .env (or set in Vercel dashboard / `vercel env add`). No real values here.

# --- Private content repo access (server-side only) ---
GITHUB_CONTENT_TOKEN=       # fine-grained GitHub PAT, read-only, scoped to captcha-content repo only
GITHUB_CONTENT_REPO=        # e.g. yourusername/captcha-content
GITHUB_CONTENT_BRANCH=main  # lets content update without redeploying the app

# --- Session / reveal token signing (jose, HS256) ---
SESSION_SECRET=             # 32+ random bytes, e.g. `openssl rand -base64 32`
REVEAL_TOKEN_SECRET=        # separate 32+ byte secret - do not reuse SESSION_SECRET

# --- Vercel Blob (auto-injected once a Blob store is attached in the dashboard) ---
BLOB_READ_WRITE_TOKEN=

# --- Vercel KV (auto-injected once a KV store is attached in the dashboard) ---
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Admin stats gate ---
ADMIN_STATS_KEY=            # shared secret for GET /api/admin/stats?key=...
